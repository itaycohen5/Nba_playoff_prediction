# This file is documentation only. The archived .env is never loaded automatically.
# Set these as environment variables in the process that starts Python:
# DATABASE_URL=sqlite:///C:/absolute/path/nba_local.db
# APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# COOKIE_SECURE=false
# Public HTTPS hosting requires COOKIE_SECURE=true and its exact APP_ORIGINS.
# Next.js optional server-side proxy destination:
# BACKEND_URL=http://127.0.0.1:8000
# Before public release, set the real accessibility contact and operator in Next.js:
# NEXT_PUBLIC_ACCESSIBILITY_EMAIL=
# NEXT_PUBLIC_SITE_OPERATOR=
# Vercel Services: root project, API served on the same domain as Next.js.
# Use the existing Supabase PostgreSQL secret in Vercel; never commit its value.
# Deployed PostgreSQL needs a reviewed migration and RLS before first startup.
# COOKIE_SECURE=true
# APP_ORIGINS=https://your-production-domain.example
